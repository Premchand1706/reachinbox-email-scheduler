# Backend Environment Configuration

PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=your_jwt_secret_key_here

# Real Google OAuth Configuration (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Ethereal SMTP Configurations (Generate one at https://ethereal.email)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your_ethereal_username
ETHEREAL_PASSWORD=your_ethereal_password
ETHEREAL_FROM="ReachInbox Scheduler <no-reply@reachinbox.ai>"

# Worker Configuration
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Developer Sandbox Bypass (Must be false for submission/production environments)
ENABLE_DEV_SANDBOX=false
